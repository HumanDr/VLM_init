{
  "_readme": [
    "视觉避障的可调参数统一入口。改完重启 launch 生效（colcon 用了 --symlink-install，改 src 下的文件即可）。",
    "优先级：avoidance.yaml < tunable.json < launch 参数（vlm_url / model / 话题 / enable 等）。",
    "键名必须与节点真实参数一致，写错会被忽略——tests/test_tunable_json.py 会帮你检查拼写。",
    "带下划线开头的键（_comment）只是注释，不会传给节点。"
  ],
  "avoidance_controller": {
    "_comment": "决策/执行层：速度、障碍判定、时序、降级、IMU、平滑自救、目的地导航",
    "cmd_vel_topic": "/cmd_vel",
    "vlm_topic": "/perception/vlm/result",
    "sector_topic": "/perception/sectors/result",
    "imu_state_topic": "/state/imu",
    "scan_sector_topic": "/perception/scan_sectors",
    "odom_topic": "/odom",
    "goal_topic": "/goal_pose",
    "plan_topic": "/plan",
    "waypoint_tolerance": 0.35,
    "odom_timeout": 0.5,
    "status_topic": "/vlm_avoid/status",
    "publish_rate_hz": 20.0,
    "enable": true,
    "require_imu": false,
    "max_linear": 0.8,
    "cruise_linear": 0.7,
    "creep_linear": 0.12,
    "max_angular": 1.4,
    "avoid_angular": 1.0,
    "stop_distance": 0.15,
    "slow_distance": 1.0,
    "obstacle_distance": 0.35,
    "release_margin": 0.25,
    "turn_min_clearance": 0.35,
    "side_margin": 0.12,
    "side_push_gain": 0.6,
    "side_push_max": 0.25,
    "side_push_distance": 0.75,
    "clear_path_distance": 0.55,
    "lateral_swerve_max_angle": 0.4363,
    "lateral_swerve_max_time": 1.0,
    "lateral_cooldown": 2.5,
    "hold_time": 1.2,
    "vlm_risk_tau": 2.5,
    "unknown_risk": 0.35,
    "obstacle_risk_threshold": 0.7,
    "prefer_side": 1,
    "goal_tolerance": 0.3,
    "goal_kp": 1.4,
    "goal_max_angular": 0.9,
    "goal_slow_angle": 0.9,
    "goal_slow_radius": 1.6,
    "vlm_stale_timeout": 3.0,
    "stale_creep": 0.12,
    "stop_after_stale": 6.0,
    "sensor_timeout": 0.5,
    "tilt_estop": 0.9,
    "heading_hold": true,
    "heading_kp": 0.9,
    "heading_max_angular": 0.35,
    "heading_deadband": 0.04,
    "heading_relock": 0.6,
    "smoothing_alpha": 0.45,
    "recovery_after": 4.0,
    "recovery_time": 2.0,
    "recovery_angular": 0.8,
    "recovery_linear": -0.06,
    "fallback_odom_topic": "/wheel_odom",
    "fallback_speed_scale": 0.6,
    "stuck_recovery_time": 1.4,
    "stuck_cooldown": 4.0
  },
  "vlm_obstacle_node": {
    "_comment": "语义通道：影响单帧耗时和判断保守程度",
    "image_topic": "/camera/image_raw",
    "result_topic": "/perception/vlm/result",
    "annotated_topic": "/perception/vlm/annotated",
    "vlm_url": "http://127.0.0.1:11434",
    "api_style": "ollama",
    "model": "qwen2.5vl:3b",
    "rate_hz": 1.5,
    "keep_alive": "30m",
    "max_side": 384,
    "jpeg_quality": 70,
    "timeout": 60.0,
    "num_predict": 96,
    "num_ctx": 4096,
