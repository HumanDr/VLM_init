    "min_valid_ratio": 0.05,
    "stride": 2,
    "camera_height": 0.16,
    "camera_pitch": 0.0873,
    "horizontal_fov": 1.2,
    "vertical_fov": 0.0,
    "ground_clearance": 0.06,
    "left_band": [
