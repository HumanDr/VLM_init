    "state_topic": "/state/imu",
    "alpha": 0.98,
    "snap_threshold": 0.5,
    "rate_hz": 30.0,
    "timeout": 0.5
  },
  "scan_sectors_node": {
    "_comment": "激光雷达扇区：张角与量程",
    "scan_topic": "/scan",
    "result_topic": "/perception/scan_sectors",
    "front_angle_deg": 40.0,
    "side_angle_deg": 100.0,
    "max_range": 12.0,
    "range_min": 0.12,
    "range_max": 20.0
  },
  "path_planner_node": {
    "_comment": "A* 全局规划：地图、膨胀半径、重规划周期",
    "goal_topic": "/goal_pose",
    "goal_cancel_topic": "/goal_cancel",
    "odom_topic": "/odom",
    "plan_topic": "/plan",
    "map_topic": "/map",
    "inflation_radius": 0.28,
    "map_offset_x": 1.5,
    "map_offset_y": 1.5,
    "replan_period": 2.0,
    "odom_timeout": 0.5,
    "publish_map": true,
    "smooth": true,
    "map_wait_timeout": 20.0,
    "map_preview_topic": "/map_preview"
  },
  "slam_node": {
    "_comment": "SLAM：扫描匹配 + 位姿图回环 + RGB-D 视觉里程计",
    "scan_topic": "/scan",
    "imu_topic": "/imu/data",
    "wheel_odom_topic": "/wheel_odom",
    "odom_topic": "/slam/odom",
    "map_topic": "/map",
    "map_frame": "odom",
    "base_frame": "base_footprint",
    "max_range": 12.0,
    "map_publish_period": 1.0,
    "keyframe_dist": 0.35,
    "keyframe_angle": 0.2,
    "loop_radius": 3.0,
    "enable_vo": true,
    "vo_rate_hz": 5.0,
    "rgb_topic": "/camera_depth/image_raw",
    "depth_topic": "/camera_depth/depth/image_raw",
    "camera_info_topic": "/camera_depth/camera_info"
  }
}
