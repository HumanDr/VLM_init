<?xml version="1.0"?>
<!--
  vlbot：两轮差速 + 前置 RGB 相机 + RGB-D 相机 + IMU 的室内巡检小车。
  刻意使用纯 URDF（不依赖 xacro），少一个运行期依赖，也方便被任何工具链加载。

  坐标约定：base_footprint 在地面，base_link 高 0.10m，车头朝 +x。
-->
<robot name="vlbot">

  <!-- ============================ 底盘 ============================ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.36 0.26 0.10"/></geometry>
      <material name="chassis_orange">
        <color rgba="0.95 0.45 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.36 0.26 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.2"/>
      <inertia ixx="0.0183" ixy="0" ixz="0" iyy="0.0256" iyz="0" izz="0.0418"/>
    </inertial>
  </link>

  <!-- 顶板（纯视觉，让 VLM 看到的车体更像小车） -->
  <link name="top_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.22 0.02"/></geometry>
      <material name="deck_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- ============================ 驱动轮 ============================ -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.065" length="0.03"/></geometry>
      <material name="wheel_black"><color rgba="0.08 0.08 0.09 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.065" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00025"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.16 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.065" length="0.03"/></geometry>
      <material name="wheel_black_r"><color rgba="0.08 0.08 0.09 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.065" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00025"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.16 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- 万向轮（低摩擦球） -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="caster_grey"><color rgba="0.6 0.6 0.65 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.25e-5" ixy="0" ixz="0" iyy="1.25e-5" iyz="0" izz="1.25e-5"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.14 0 -0.075" rpy="0 0 0"/>
  </joint>

  <!-- ============================ 传感器 ============================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.06 0.04"/></geometry>
      <material name="cam_black"><color rgba="0.05 0.05 0.06 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.06 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.0e-5" iyz="0" izz="1.4e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- 略向下俯视，能看到车头正前方的地面与障碍物底部 -->
    <origin xyz="0.17 0 0.06" rpy="0 -0.0873 0"/>
  </joint>

  <!-- 光学坐标系：z 向前、x 向右、y 向下（ROS 图像约定） -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.02 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- 2D 激光雷达：装在顶板中央，扫描平面离地 0.21m -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_black"><color rgba="0.05 0.05 0.06 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="7e-5"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- ============================ Gazebo 插件 ============================ -->
  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="top_plate"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="caster_wheel">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="camera_link"><material>Gazebo/Black</material></gazebo>

  <!-- 差速驱动：订阅 /cmd_vel，发布 /odom 与 odom->base_footprint TF -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <!-- 轮式里程计改到 /wheel_odom，只用于漂移诊断；
             对外 /odom 由真值插件提供（见文件末尾 ground_truth_odom 插件） -->
        <remapping>odom:=wheel_odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_diameter>0.13</wheel_diameter>
      <max_wheel_torque>8.0</max_wheel_torque>
      <max_wheel_acceleration>4.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 轮子关节状态：让 rviz2 里轮子真的会转 -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- RGB 相机：640x480 @10Hz -> /camera/image_raw
       注意 ROS2 的 gazebo_ros_camera 用 snake_case 标签（camera_name/frame_name），
       camelCase 是 ROS1 写法、会被静默忽略；话题拼法是 camera_name + "/image_raw"。 -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="front_camera">
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.20</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>B8G8R8</format>
        </image>
        <clip><near>0.05</near><far>40.0</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 深度相机：320x240 @10Hz
       插件的话题拼法是 camera_name + "/depth/image_raw"：
       depth  -> /camera_depth/depth/image_raw
       points -> /camera_depth/points
       （/camera_depth/image_raw 是它自带的彩色图，本链路不用） -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="front_depth_camera">
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.20</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>B8G8R8</format>
        </image>
        <depth_camera></depth_camera>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
      <plugin name="depth_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera_depth</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU：100Hz -> /imu/data -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.012</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.012</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.012</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 2D 激光雷达：360°，720 线，10Hz，0.12~20m -> /scan
       LiDAR 是主动测距：不受光照/纹理影响，也不依赖模型判断，
       所以它和深度一起构成几何安全网（两者取更小的距离）。 -->
  <gazebo reference="laser_link">
    <sensor type="ray" name="lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 真值位姿（仿真专用）：发布到 /ground_truth/odom，由
       vlm_control/ground_truth_odom 换算成"相对出生点"的 /odom + TF。
       这样地图和 Gazebo 世界严格对齐，撞墙打滑也不会漂。 -->
  <gazebo>
    <plugin name="ground_truth_odom" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/</namespace>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
